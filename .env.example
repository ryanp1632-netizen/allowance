# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your keys never get committed.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# There is no setting for the PayPal URL: the app is locked to the sandbox
# (fake money) in src/config.js and refuses to start if PAYPAL_API_BASE
# points anywhere else.

# --- AI provider: "gemini" (default) or "groq" ---
AI_PROVIDER=gemini
# Gemini key from https://aistudio.google.com/apikey
# FREE TIER ONLY: do not enable billing on this key's project. Without billing,
# going over the free limit just returns an error; it can never charge you.
GEMINI_API_KEY=
# Optional Groq fallback key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model name (leave blank for the default)
AI_MODEL=

# --- App ---
PORT=3000
