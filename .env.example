# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your keys never get committed.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave as-is: we only ever talk to the sandbox (fake money).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- AI provider: "gemini" (default) or "groq" ---
AI_PROVIDER=gemini
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional Groq fallback key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model name (leave blank for the default)
AI_MODEL=

# --- App ---
PORT=3000
